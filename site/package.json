{
  "name": "elm-test-suite-site",
  "private": true,
  "type": "module",
  "description": "The elm-test-suite results website, built with elm-pages from the data runner/site-data.js writes",
  "scripts": {
    "postinstall": "elm-tooling install",
    "prestart": "node scripts/site-url.mjs",
    "start": "elm-pages dev",
    "prebuild": "node scripts/site-url.mjs",
    "build": "elm-pages build",
    "test": "elm-test --compiler ./node_modules/.bin/elm"
  },
  "devDependencies": {
    "elm-optimize-level-2": "^0.3.5",
    "elm-pages": "3.5.1",
    "elm-review": "^2.13.5",
    "elm-test": "0.19.1-revision12",
    "elm-tooling": "^1.21.0",
    "katex": "0.19.1",
    "lamdera": "^0.19.1-1.4.0",
    "vite": "^7.3.1"
  }
}
