    ("::", (⟨[.ty (.bnd 0 .any)], (.fn (.var (.bnd 0 .any)) (.fn (.con [(.var (.bnd 0 .any))] tList) (.con [(.var (.bnd 0 .any))] tList)))⟩, .c)),
    ("==", (⟨[.ty (.bnd 0 .any)], (.fn (.var (.bnd 0 .any)) (.fn (.var (.bnd 0 .any)) (.con [] tBool)))⟩, .v)),
    ("/=", (⟨[.ty (.bnd 0 .any)], (.fn (.var (.bnd 0 .any)) (.fn (.var (.bnd 0 .any)) (.con [] tBool)))⟩, .v)),
    ("<", (⟨[.ty (.bnd 0 .comp)], (.fn (.var (.bnd 0 .comp)) (.fn (.var (.bnd 0 .comp)) (.con [] tBool)))⟩, .v)),
    (">", (⟨[.ty (.bnd 0 .comp)], (.fn (.var (.bnd 0 .comp)) (.fn (.var (.bnd 0 .comp)) (.con [] tBool)))⟩, .v)),
    ("<=", (⟨[.ty (.bnd 0 .comp)], (.fn (.var (.bnd 0 .comp)) (.fn (.var (.bnd 0 .comp)) (.con [] tBool)))⟩, .v)),
    (">=", (⟨[.ty (.bnd 0 .comp)], (.fn (.var (.bnd 0 .comp)) (.fn (.var (.bnd 0 .comp)) (.con [] tBool)))⟩, .v)),
    ("&&", (⟨[], (.fn (.con [] tBool) (.fn (.con [] tBool) (.con [] tBool)))⟩, .v)),
    ("||", (⟨[], (.fn (.con [] tBool) (.fn (.con [] tBool) (.con [] tBool)))⟩, .v)),
    ("|>", (⟨[.ty (.bnd 0 .any), .ty (.bnd 1 .any)], (.fn (.var (.bnd 0 .any)) (.fn (.fn (.var (.bnd 0 .any)) (.var (.bnd 1 .any))) (.var (.bnd 1 .any))))⟩, .v)),
    ("<|", (⟨[.ty (.bnd 0 .any), .ty (.bnd 1 .any)], (.fn (.fn (.var (.bnd 0 .any)) (.var (.bnd 1 .any))) (.fn (.var (.bnd 0 .any)) (.var (.bnd 1 .any))))⟩, .v)) ]

