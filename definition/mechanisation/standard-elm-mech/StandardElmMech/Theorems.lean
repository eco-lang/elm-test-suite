/-
  A Standard Definition of Elm? Mechanisation, part 11.
  Machine-checked statements that the definition derives the examples'
  values.

  * `kc_<Shard>_<n>`: one theorem per check whose value is an Int, a
    constructor without arguments or a string, proved by `decide +kernel`:
    the kernel itself runs the evaluator, and `kcheck_sound` (from
    `evExp_sound`) turns the result into a derivation of the relation
    `EvalExp`. These theorems are generated by the command `#kernel_checks`
    below, which reads a list of programs at compile time; each shard of the
    translated tests runs it in its own file (Generated/Checks<Shard>.lean).
  * `derivable_<Shard>`, `derivable_Hand` (from `derivableOf`): every check
    of the translated tests, and of the hand translations in `handPartial`,
    that expects a value has a derivation whose value prints as the CHECK
    value. Proved with `native_decide` (which trusts the compiler) because
    values are compared as printed strings.
  * Hand-stated theorems for the rulings A42, A43, A44, A48, A49 and A51.
-/
import Lean
import StandardElmMech.Examples
import StandardElmMech.Sound

namespace StandardElm
open StandardElm.D

def fuelT : Nat := 100000


/-! ## The values of Basics written in Elm (sec:appendix-dynamic-basis-elm) -/

/-- A text `var atpat1 ... atpatn = exp`, not recursive, evaluates in E by
    r:d-dec-nonrec (with r:d-valbind-var and r:d-exp-lambda) to the closure
    that InitialBasis.lean binds. -/
theorem elmText_derivation (E : Env) (x : Var) (p : AtPat) (ps : List AtPat) (e : Exp)
    (h : isRecursive [(x, .closure p (lams ps e) E [])] (.var x (lams (p :: ps) e) none) = false) :
    EvalDec E (.val (.var x (lams (p :: ps) e) none)) [(x, .closure p (lams ps e) E [])] := by
  have hv : EvalValBind E (.var x (lams (p :: ps) e) none) (fmPlus [(x, .closure p (lams ps e) E [])] []) :=
    EvalValBind.r_d_valbind_var _ _ _ _ _ _ (EvalExp.r_d_exp_lambda E p (lams ps e)) (EvalValBindOpt.opt_none _)
  have he : fmPlus [(x, Val.closure p (lams ps e) E [])] ([] : ValEnv) = [(x, .closure p (lams ps e) E [])] := by
    simp [fmPlus]
  rw [he] at hv
  exact EvalDec.r_d_dec_nonrec _ _ _ hv h

def elmTextNonRec : Def → Bool
  | .fn x (p :: ps) e => !isRecursive [(x, .closure p (lams ps e) E_K [])] (.var x (lams (p :: ps) e) none)
  | _ => false

theorem elmTexts_nonrec : elmTexts.all elmTextNonRec = true := by decide +kernel

/-- Every text of the fragment evaluates in E_K to the value VE_elm binds. -/
theorem elmTexts_eval : ∀ x p ps e, Def.fn x (p :: ps) e ∈ elmTexts →
    EvalDec E_K (.val (.var x (lams (p :: ps) e) none)) [(x, .closure p (lams ps e) E_K [])] := by
  intro x p ps e hm
  apply elmText_derivation
  have := List.all_eq_true.mp elmTexts_nonrec _ hm
  simpa [elmTextNonRec] using this

/-! ## First-order expectations, checkable by the kernel -/

inductive Expect where
  | int (n : Int)
  | con (name : String)
  | str (s : String)

def Expect.holds : Val → Expect → Prop
  | v, .int n => v = .sv (.int n)
  | v, .con k => ∃ c, v = .con c [] ∧ c.name = k
  | v, .str s => v = .sv (.str s)

def kcheckVal : Val → Expect → Bool
  | .sv (.int m), .int n => m == n
  | .con c [], .con k => c.name == k
  | .sv (.str s), .str t => s == t
  | _, _ => false

theorem kcheckVal_holds {v : Val} {x : Expect} : kcheckVal v x = true → x.holds v := by
  unfold kcheckVal; split <;> simp_all [Expect.holds]

def kcheck (ch : Bool) (E : Env) (e : Exp) (x : Expect) : Bool :=
  match evExp ch fuelT E e with
  | some v => kcheckVal v x
  | none => false

theorem kcheck_sound {ch : Bool} {E : Env} {e : Exp} {x : Expect} :
    kcheck ch E e x = true → ∃ v, EvalExp E e v ∧ x.holds v := by
  unfold kcheck; split
  · rename_i v h; intro hx; exact ⟨v, evExp_sound h, kcheckVal_holds hx⟩
  · intro h; cases h

/-- A check is kernel-checkable when its value is an Int, a constructor
    without arguments or a string. -/
def expectOf (s : String) : Option Expect :=
  match s.toInt? with
  | some n => some (.int n)
  | none =>
    let inner := ((s.drop 1).dropEnd 1).toString
    if s.length ≥ 2 && s.front == '"' && s.back == '"' && !(inner.toList.contains '"') then
      some (.str inner)
    else if s.all Char.isAlphanum && s.length > 0 && s.front.isUpper then some (.con s)
    else none

/-- Known divergences: checks whose expected value the definition does not
    give, excluded from the agreement theorems. Every example is now a test
    program whose CHECK lines state the book's value, so there are none. -/
def knownDiv : List (String × String) := []

/-- Checks whose value is a float, compared as printed and left to
    `native_decide`: for hand-written checks, whose kind is not recorded. -/
def floatValued (p : Program) (_ck : Check) : Bool :=
  p.name == "CoreIssue1080ClampNanTest"

/-- The expectation the kernel checks for a check, if it can: none for a
    known divergence or a program that uses a value only the C library
    computes (`Program.native`); by the check's kind for a translated check (an Int, a
    string, or a constructor without arguments; never a float, which may print
    as `NaN` or `3`); by its expected value for a hand-written one. -/
def kernelCheck? (p : Program) (ck : Check) : Option Expect :=
  if knownDiv.contains (p.name, ck.label) || p.native then none else
  match ck.kind with
  | .unknown => if floatValued p ck then none else expectOf ck.expected
  | .int => match expectOf ck.expected with
    | some (.int n) => some (.int n)
    | _ => none
  | .string => match expectOf ck.expected with
    | some (.str s) => some (.str s)
    | _ => none
  | .data => match expectOf ck.expected with
    | some (.con k) => some (.con k)
    | _ => none
  | _ => none

open Lean Elab Command in
/-- `#kernel_checks ps "P"` emits, for each check of the programs `ps` that
    `kernelCheck?` selects, a theorem `kc_P_<n>` (n counting from 0 in `ps`)
    that the rules derive the check's value, proved by `decide +kernel`. -/
elab "#kernel_checks " ps:ident pre:str : command => do
  let name ← liftCoreM <| realizeGlobalConstNoOverloadWithInfo ps
  let progs ← liftTermElabM <| unsafe Meta.evalExpr (List Program)
    (mkApp (mkConst ``List [Level.zero]) (mkConst ``StandardElm.Program)) (mkConst name)
  let src := ps.getId.toString
  let pfx := pre.getString
  let mut k := 0
  for pi in List.range progs.length do
    let p := progs[pi]!
    for ci in List.range p.checks.length do
      let c := p.checks[ci]!
      match kernelCheck? p c with
      | none => pure ()
      | some x =>
        let xs : String := match x with
          | .int n => s!"(Expect.int ({n}))"
          | .con s => s!"(Expect.con \"{s}\")"
          | .str s => s!"(Expect.str {repr s})"
        let thm := s!"kc_{pfx}_{k}"
        let stx := s!"/-- {p.name}: {c.label} -/\ntheorem {thm} : ∃ v, EvalExp ({src}[{pi}]!).env (({src}[{pi}]!).phrase ({src}[{pi}]!).checks[{ci}]!) v ∧ {xs}.holds v := by\n  first\n  | exact kcheck_sound (ch := false) (by decide +kernel)\n  | exact kcheck_sound (ch := true) (by decide +kernel)"
        match Parser.runParserCategory (← getEnv) `command stx with
        | .ok cmd => elabCommand cmd
        | .error err => throwError err
        k := k + 1
  logInfo m!"#kernel_checks {pfx}: {k} theorems proved by decide +kernel"

/-! ## All checks, compared as printed values -/

def checkShowWith (shw : Val → String) (ch : Bool) (E : Env) (e : Exp) (s : String) : Bool :=
  match evExp ch fuelT E e with
  | some v => shw v == s
  | none => false

theorem checkShowWith_sound {shw : Val → String} {ch : Bool} {E : Env} {e : Exp} {s : String} :
    checkShowWith shw ch E e s = true → ∃ v, EvalExp E e v ∧ shw v = s := by
  unfold checkShowWith; split
  · rename_i v h; intro hs; exact ⟨v, evExp_sound h, by simpa using hs⟩
  · intro h; cases h

/-- The value of a phrase, printed as Elm's Debug.log prints it, is `s`. -/
def checkShow (ch : Bool) (E : Env) (e : Exp) (s : String) : Bool :=
  checkShowWith showElm ch E e s

theorem checkShow_sound {ch : Bool} {E : Env} {e : Exp} {s : String} :
    checkShow ch E e s = true → ∃ v, EvalExp E e v ∧ showElm v = s :=
  checkShowWith_sound

/-- Every check of a program agrees, with one of the two choices of a member
    of APPLY, except a check that expects no value (a program that stops at
    Debug.todo: the evaluator's soundness speaks only of the values it gives,
    so it cannot show that an expression has none; `lake exe run-examples`
    checks those) and a known divergence. -/
def valuesAgree (p : Program) : Bool :=
  p.checks.all fun ck =>
    ck.expected == "(no value)" || knownDiv.contains (p.name, ck.label) ||
    checkShow false p.env (p.phrase ck) ck.expected || checkShow true p.env (p.phrase ck) ck.expected

/-- For a list of programs whose checks all agree (`valuesAgree`, decided by
    `native_decide` for each shard of the generated programs), every check
    that expects a value and is not a known divergence is derivable with the
    value its test expects. -/
theorem derivableOf (ps : List Program) (h : ps.all valuesAgree = true) :
    ∀ p ∈ ps, ∀ ck ∈ p.checks, ck.expected ≠ "(no value)" →
      ¬ knownDiv.contains (p.name, ck.label) = true →
        ∃ v, EvalExp p.env (p.phrase ck) v ∧ showElm v = ck.expected := by
  intro p hp ck hck hne hk
  have := List.all_eq_true.mp (List.all_eq_true.mp h p hp) ck hck
  simp only [Bool.or_eq_true, beq_iff_eq] at this
  rcases this with ((h1 | h1) | h1) | h1
  · exact absurd h1 hne
  · exact absurd h1 hk
  · exact checkShow_sound h1
  · exact checkShow_sound h1

#kernel_checks handPartial "Hand"

/-- The hand-translated checks of `handPartial` that expect a value are
    derivable. -/
theorem derivable_Hand :
    ∀ p ∈ handPartial, ∀ ck ∈ p.checks, ck.expected ≠ "(no value)" →
      ¬ knownDiv.contains (p.name, ck.label) = true →
        ∃ v, EvalExp p.env (p.phrase ck) v ∧ showElm v = ck.expected :=
  derivableOf handPartial (by native_decide)

/-! ## The rulings, stated directly (kernel-checked) -/

/-- A43: 1 ^ -1 is 1 (eco: 0). -/
theorem a43_one : ∃ w, EvalExp E0 (bin "^" (i 1) (i (-1))) w ∧ (Expect.int 1).holds w :=
  kcheck_sound (ch := false) (by decide +kernel)

/-- A43: (-1) ^ -3 is -1 (eco: 0). -/
theorem a43_minus_one_odd :
    ∃ w, EvalExp E0 (bin "^" (.atexp (.paren (i (-1)))) (i (-3))) w ∧ (Expect.int (-1)).holds w :=
  kcheck_sound (ch := false) (by decide +kernel)

/-- A43: (-1) ^ -2 is 1 (eco: 0). -/
theorem a43_minus_one_even :
    ∃ w, EvalExp E0 (bin "^" (.atexp (.paren (i (-1)))) (i (-2))) w ∧ (Expect.int 1).holds w :=
  kcheck_sound (ch := false) (by decide +kernel)

/-- A43: APPLY(pow, 1, -1) = {1}: the set has one member, so the definition
    gives no other value for 1 ^ -1 at this step. -/
theorem a43_apply_singleton : applySet .pow [.int 1, .int (-1)] = [.int 1] := by
  simp [applySet]

/-- A42: 3 // 0, modBy 0 3 and remainderBy 0 3 are all 0. -/
theorem a42_idiv : ∃ w, EvalExp E0 (bin "//" (i 3) (i 0)) w ∧ (Expect.int 0).holds w :=
  kcheck_sound (ch := false) (by decide +kernel)
theorem a42_modBy : ∃ w, EvalExp E0 (ap (v "modBy") [i 0, i 3]) w ∧ (Expect.int 0).holds w :=
  kcheck_sound (ch := false) (by decide +kernel)
theorem a42_remainderBy : ∃ w, EvalExp E0 (ap (v "remainderBy") [i 0, i 3]) w ∧ (Expect.int 0).holds w :=
  kcheck_sound (ch := false) (by decide +kernel)

/-- A48: at floats APPLY(max) and APPLY(min) are IEEE 754-2019 maximum and
    minimum, whatever the order of the arguments: NaN when either is NaN,
    +0 for max and -0 for min of the two zeros. Floats are compared as
    printed, so this is proved by `native_decide`. -/
theorem a48_float :
    let f (x : Float) : Val := .sv (.float x)
    let nan : Float := 0 / 0
    let nz : Float := -0
    ([applySet .max [f nan, f 1], applySet .max [f 1, f nan],
      applySet .min [f nan, f 1], applySet .min [f 1, f nan],
      applySet .max [f 0, f nz], applySet .max [f nz, f 0],
      applySet .min [f 0, f nz], applySet .min [f nz, f 0]].map (·.map showElmSigned))
      = [["NaN"], ["NaN"], ["NaN"], ["NaN"], ["+0"], ["+0"], ["-0"], ["-0"]] := by
  native_decide

/-- A48: at Int, max and min give the elm/core text's result
    (kernel-checked). -/
theorem a48_int_max : ∃ w, EvalExp E0 (ap (v "max") [i 3, i 10]) w ∧ (Expect.int 10).holds w :=
  kcheck_sound (ch := false) (by decide +kernel)
theorem a48_int_min : ∃ w, EvalExp E0 (ap (v "min") [i 3, i 10]) w ∧ (Expect.int 3).holds w :=
  kcheck_sound (ch := false) (by decide +kernel)

/-- A49: at floats APPLY(clamp, lo, hi, x) is min (max x lo) hi with the
    IEEE 754-2019 minimum and maximum: hi when lo > hi, NaN when any argument
    is NaN, +0 for clamp 0 1 -0. Floats are compared as printed, so this is
    proved by `native_decide`. -/
theorem a49_apply_float :
    let f (x : Float) : Val := .sv (.float x)
    let nan : Float := 0 / 0
    let nz : Float := -0
    ([applySet .clamp [f 10, f 0, f 5], applySet .clamp [f nan, f 1, f 0.5],
      applySet .clamp [f 0, f nan, f 0.5], applySet .clamp [f 0, f 1, f nan],
      applySet .clamp [f 0, f 1, f nz], applySet .clamp [f (-1), f nz, f 0],
      applySet .clamp [f 0, f 1, f 0.5]].map (·.map showElmSigned))
      = [["+0"], ["NaN"], ["NaN"], ["NaN"], ["+0"], ["-0"], ["0.5"]] := by
  native_decide

/-- A49 through the rules: `clamp 10 0 5` at Float evaluates to +0 (hi),
    by r:d-app-basic-partial and r:d-app-basic-apply with APPLY(clamp). -/
theorem a49_float_lo_gt_hi :
    ∃ w, EvalExp E0 (ap (v "clamp") [fI 10, fI 0, fI 5]) w ∧ showElmSigned w = "+0" :=
  checkShowWith_sound (ch := false) (by native_decide)

/-- A49: `clamp nan 1 0.5` at Float evaluates to NaN. -/
theorem a49_float_nan_bound :
    ∃ w, EvalExp E0 (ap (v "clamp") [.atexp (.paren (bin "/" (fI 0) (fI 0))), fI 1, fHalf]) w ∧
      showElm w = "NaN" :=
  checkShow_sound (ch := false) (by native_decide)

/-- A49: `clamp 0 1 -0` at Float evaluates to +0. -/
theorem a49_float_signed_zero :
    ∃ w, EvalExp E0 (ap (v "clamp") [fI 0, fI 1, .atexp (neg (.scon (.intF 0)))]) w ∧
      showElmSigned w = "+0" :=
  checkShowWith_sound (ch := false) (by native_decide)

/-- A49: at Int, clamp gives the elm/core text's result: `clamp 10 0 5` is
    10 (lo, since 5 < 10), kernel-checked. -/
theorem a49_int_lo_gt_hi : ∃ w, EvalExp E0 (ap (v "clamp") [i 10, i 0, i 5]) w ∧ (Expect.int 10).holds w :=
  kcheck_sound (ch := false) (by decide +kernel)

/-- A49: APPLY(clamp, 10, 0, 5) = {10} at Int: the set has one member. -/
theorem a49_int_apply_singleton : applySet .clamp [.int 10, .int 0, .int 5] = [.int 10] := by
  simp [applySet, cmp, cmpInt, isFloat, pickFirst]

/-- A51: `(\x -> x) == (\x -> x)` evaluates to True ... -/
theorem a51_true :
    ∃ w, EvalExp E0 (eq (.atexp (.paren (lams [pv "x"] (v "x")))) (.atexp (.paren (lams [pv "x"] (v "x")))))
      w ∧ (Expect.con "True").holds w :=
  kcheck_sound (ch := false) (by decide +kernel)

/-- ... and to False: both results are derivable. -/
theorem a51_false :
    ∃ w, EvalExp E0 (eq (.atexp (.paren (lams [pv "x"] (v "x")))) (.atexp (.paren (lams [pv "x"] (v "x")))))
      w ∧ (Expect.con "False").holds w :=
  kcheck_sound (ch := true) (by decide +kernel)

/-- A44: the conversions to Int at 2.5, -2.5, NaN, the infinities and 1e300,
    in that order: `round` rounds a half upward (x + 1/2 exact), and every
    conversion saturates into [-2^63, 2^63 - 1], NaN giving 0. `Float.floor`
    is computed by the C library, so this is proved by `native_decide`. -/
theorem a44_conversions :
    let f (x : Float) : Val := .sv (.float x)
    let xs : List Float := [2.5, -2.5, 0 / 0, 1 / 0, -1 / 0, 1e300]
    [BasVal.round, .floor, .ceiling, .truncate].map (fun b => xs.map fun x => (applySet b [f x]).map showElm)
      = [[["3"], ["-2"], ["0"], ["9223372036854775807"], ["-9223372036854775808"], ["9223372036854775807"]],
         [["2"], ["-3"], ["0"], ["9223372036854775807"], ["-9223372036854775808"], ["9223372036854775807"]],
         [["3"], ["-2"], ["0"], ["9223372036854775807"], ["-9223372036854775808"], ["9223372036854775807"]],
         [["2"], ["-2"], ["0"], ["9223372036854775807"], ["-9223372036854775808"], ["9223372036854775807"]]] := by
  native_decide

/-- A44: `round -2.5` is -2, by the rules from E0. -/
theorem a44_round_minus_half :
    ∃ w, EvalExp E0 (ap (v "round") [.atexp (neg (.scon (.float 25 (-1))))]) w ∧ showElm w = "-2" :=
  checkShowWith_sound (ch := false) (by native_decide)

end StandardElm
