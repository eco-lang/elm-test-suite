    let ⟨l2, h2l⟩ := MatchPat.lift h2
    ⟨_, .r_d_pat_cons_l E v v1 v2 p1 p2 r1 r2 l1 l2 h0 h1l h2l⟩
  | _, _, _, _, .r_d_pat_cons_fail E v p1 p2 h0 =>
    ⟨_, .r_d_pat_cons_fail_l E v p1 p2 h0⟩
  | _, _, _, _, .r_d_pat_as E v p x r h0 =>
    let ⟨l1, h0l⟩ := MatchPat.lift h0
    ⟨_, .r_d_pat_as_l E v p x r l1 h0l⟩
theorem EvalExpOpt.lift : ∀ {x0 x1 x2}, EvalExpOpt x0 x1 x2 → ∃ l, EvalExpOptL x0 x1 x2 l
  | _, _, _, .opt_none E  =>
    ⟨_, .opt_none_l E ⟩
  | _, _, _, .opt_some E e v h0 =>
    let ⟨l1, h0l⟩ := EvalExp.lift h0
    ⟨_, .opt_some_l E e v l1 h0l⟩
theorem EvalExpRowOpt.lift : ∀ {x0 x1 x2}, EvalExpRowOpt x0 x1 x2 → ∃ l, EvalExpRowOptL x0 x1 x2 l
  | _, _, _, .opt_none E  =>
    ⟨_, .opt_none_l E ⟩
  | _, _, _, .opt_some E row r h0 =>
    let ⟨l1, h0l⟩ := EvalExpRow.lift h0
    ⟨_, .opt_some_l E row r l1 h0l⟩
theorem EvalValBindOpt.lift : ∀ {x0 x1 x2}, EvalValBindOpt x0 x1 x2 → ∃ l, EvalValBindOptL x0 x1 x2 l
  | _, _, _, .opt_none E  =>
    ⟨_, .opt_none_l E ⟩
  | _, _, _, .opt_some E vb VE h0 =>
    let ⟨l1, h0l⟩ := EvalValBind.lift h0
    ⟨_, .opt_some_l E vb VE l1 h0l⟩
theorem MatchPatOpt.lift : ∀ {x0 x1 x2 x3}, MatchPatOpt x0 x1 x2 x3 → ∃ l, MatchPatOptL x0 x1 x2 x3 l
  | _, _, _, _, .opt_none E  =>
    ⟨_, .opt_none_l E ⟩
  | _, _, _, _, .opt_some E v p r h0 =>
    let ⟨l1, h0l⟩ := MatchPat.lift h0
    ⟨_, .opt_some_l E v p r l1 h0l⟩
theorem MatchPatRowOpt.lift : ∀ {x0 x1 x2 x3}, MatchPatRowOpt x0 x1 x2 x3 → ∃ l, MatchPatRowOptL x0 x1 x2 x3 l
  | _, _, _, _, .opt_none E r  =>
    ⟨_, .opt_none_l E r ⟩
  | _, _, _, _, .opt_some E r row VE h0 =>
    let ⟨l1, h0l⟩ := MatchPatRow.lift h0
    ⟨_, .opt_some_l E r row VE l1 h0l⟩
theorem MatchAtPats.lift : ∀ {x0 x1 x2 x3}, MatchAtPats x0 x1 x2 x3 → ∃ l, MatchAtPatsL x0 x1 x2 x3 l
  | _, _, _, _, .seq_nil E  =>
    ⟨_, .seq_nil_l E ⟩
  | _, _, _, _, .seq_cons E v vs a as r rs h0 h1 =>
    let ⟨l1, h0l⟩ := MatchAtPat.lift h0
    let ⟨l2, h1l⟩ := MatchAtPats.lift h1
    ⟨_, .seq_cons_l E v vs a as r rs l1 l2 h0l h1l⟩
end

