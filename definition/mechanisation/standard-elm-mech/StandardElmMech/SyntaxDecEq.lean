/-
  A Standard Definition of Elm? Mechanisation: decidable equality of the reduced syntax (Syntax.lean,
  Mod/Syntax.lean) and of the bare syntax (Src/Bare.lean), plan step 10.

  The deriving handler does not apply to mutual nested inductive types, so the instances are written
  out (generated by a script, in the style of `Ty.decEq` in Stat/Objects.lean): structural recursion,
  one case per pair of constructors, so that `decide +kernel` reduces them.
-/
import StandardElmMech.Mod.Syntax
import StandardElmMech.Src.Bare

namespace StandardElm

deriving instance DecidableEq for SCon

mutual
def AtExp.decEq : (a b : AtExp) → Decidable (a = b)
  | .scon x0, .scon y0 =>
    match _root_.decEq x0 y0 with
    | isTrue h0 => isTrue (by subst h0; rfl)
    | isFalse h0 => isFalse (by intro e; cases e; exact h0 rfl)
  | .var x0, .var y0 =>
    match _root_.decEq x0 y0 with
    | isTrue h0 => isTrue (by subst h0; rfl)
    | isFalse h0 => isFalse (by intro e; cases e; exact h0 rfl)
  | .con x0, .con y0 =>
    match _root_.decEq x0 y0 with
    | isTrue h0 => isTrue (by subst h0; rfl)
    | isFalse h0 => isFalse (by intro e; cases e; exact h0 rfl)
  | .op x0, .op y0 =>
    match _root_.decEq x0 y0 with
    | isTrue h0 => isTrue (by subst h0; rfl)
    | isFalse h0 => isFalse (by intro e; cases e; exact h0 rfl)
  | .unit, .unit => isTrue rfl
  | .tuple x0 x1 x2, .tuple y0 y1 y2 =>
    match Exp.decEq x0 y0, Exp.decEq x1 y1, Exp.decEqOpt x2 y2 with
    | isTrue h0, isTrue h1, isTrue h2 => isTrue (by subst h0; subst h1; subst h2; rfl)
    | isFalse h0, _, _ => isFalse (by intro e; cases e; exact h0 rfl)
    | _, isFalse h1, _ => isFalse (by intro e; cases e; exact h1 rfl)
    | _, _, isFalse h2 => isFalse (by intro e; cases e; exact h2 rfl)
  | .nil, .nil => isTrue rfl
  | .record x0, .record y0 =>
    match ExpRow.decEqOpt x0 y0 with
    | isTrue h0 => isTrue (by subst h0; rfl)
    | isFalse h0 => isFalse (by intro e; cases e; exact h0 rfl)
  | .update x0 x1, .update y0 y1 =>
    match _root_.decEq x0 y0, ExpRow.decEq x1 y1 with
    | isTrue h0, isTrue h1 => isTrue (by subst h0; subst h1; rfl)
    | isFalse h0, _ => isFalse (by intro e; cases e; exact h0 rfl)
    | _, isFalse h1 => isFalse (by intro e; cases e; exact h1 rfl)
  | .letE x0 x1, .letE y0 y1 =>
    match Dec.decEq x0 y0, Exp.decEq x1 y1 with
    | isTrue h0, isTrue h1 => isTrue (by subst h0; subst h1; rfl)
    | isFalse h0, _ => isFalse (by intro e; cases e; exact h0 rfl)
    | _, isFalse h1 => isFalse (by intro e; cases e; exact h1 rfl)
  | .paren x0, .paren y0 =>
    match Exp.decEq x0 y0 with
    | isTrue h0 => isTrue (by subst h0; rfl)
    | isFalse h0 => isFalse (by intro e; cases e; exact h0 rfl)
