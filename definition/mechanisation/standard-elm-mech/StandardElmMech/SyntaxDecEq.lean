    | isTrue h0, isTrue h1 => isTrue (by subst h0; subst h1; rfl)
    | isFalse h0, _ => isFalse (by intro e; cases e; exact h0 rfl)
    | _, isFalse h1 => isFalse (by intro e; cases e; exact h1 rfl)
  | .as x0 x1, .as y0 y1 =>
    match Pat.decEq x0 y0, _root_.decEq x1 y1 with
    | isTrue h0, isTrue h1 => isTrue (by subst h0; subst h1; rfl)
    | isFalse h0, _ => isFalse (by intro e; cases e; exact h0 rfl)
    | _, isFalse h1 => isFalse (by intro e; cases e; exact h1 rfl)
  | .atpat _, .con _ _
  | .atpat _, .cons _ _
  | .atpat _, .as _ _
  | .con _ _, .atpat _
  | .con _ _, .cons _ _
  | .con _ _, .as _ _
  | .cons _ _, .atpat _
  | .cons _ _, .con _ _
  | .cons _ _, .as _ _
  | .as _ _, .atpat _
  | .as _ _, .con _ _
  | .as _ _, .cons _ _ => isFalse (by intro e; cases e)
def Exp.decEqOpt : (a b : Option Exp) → Decidable (a = b)
  | none, none => isTrue rfl
  | some x, some y =>
    match Exp.decEq x y with
    | isTrue h => isTrue (by subst h; rfl)
    | isFalse h => isFalse (by intro e; cases e; exact h rfl)
  | none, some _ | some _, none => isFalse (by intro e; cases e)
def ExpRow.decEqOpt : (a b : Option ExpRow) → Decidable (a = b)
  | none, none => isTrue rfl
  | some x, some y =>
