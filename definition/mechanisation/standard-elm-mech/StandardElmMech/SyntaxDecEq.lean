  | .var x0 x1 x2, .var y0 y1 y2 =>
    match _root_.decEq x0 y0, Exp.decEq x1 y1, ValBind.decEqOpt x2 y2 with
    | isTrue h0, isTrue h1, isTrue h2 => isTrue (by subst h0; subst h1; subst h2; rfl)
