  | .atexp _, .lam _ _
  | .atexp _, .caseE _ _
  | .app _ _, .atexp _
  | .app _ _, .lam _ _
  | .app _ _, .caseE _ _
  | .lam _ _, .atexp _
  | .lam _ _, .app _ _
  | .lam _ _, .caseE _ _
  | .caseE _ _, .atexp _
  | .caseE _ _, .app _ _
  | .caseE _ _, .lam _ _ => isFalse (by intro e; cases e)
