def PatRow.decEqOpt : (a b : Option PatRow) → Decidable (a = b)
  | none, none => isTrue rfl
  | some x, some y =>
    match PatRow.decEq x y with
    | isTrue h => isTrue (by subst h; rfl)
    | isFalse h => isFalse (by intro e; cases e; exact h rfl)
  | none, some _ | some _, none => isFalse (by intro e; cases e)
def AtPat.decEqList : (a b : List AtPat) → Decidable (a = b)
  | [], [] => isTrue rfl
  | x :: xs, y :: ys =>
    match AtPat.decEq x y, AtPat.decEqList xs ys with
    | isTrue h1, isTrue h2 => isTrue (by subst h1; subst h2; rfl)
    | isFalse h1, _ => isFalse (by intro e; cases e; exact h1 rfl)
    | _, isFalse h2 => isFalse (by intro e; cases e; exact h2 rfl)
  | [], _ :: _ | _ :: _, [] => isFalse (by intro e; cases e)
end
