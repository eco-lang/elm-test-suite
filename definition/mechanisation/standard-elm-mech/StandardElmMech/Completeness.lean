    ∃ (L : List Bool) (n : Nat), ∀ (oo : Oracle) (k m : Nat), n ≤ m → Agrees oo k L →
      matchAtPats oo m x0 x1 x2 k = ⟨.value x3, x4, k + L.length⟩
  | _, _, _, _, _, .seq_nil_l E  => by
      refine ⟨[], 0 + 1, ?_⟩
      intro oo k m hm hag
      obtain ⟨mm, rfl⟩ : ∃ mm, m = mm + 1 := ⟨m - 1, by omega⟩
      simp only [matchAtPats]
      try simp only [sconTest_iff, conIs_iff]
      try simp [sconTest_iff, conIs_iff, List.length_append, Nat.add_assoc]
      try omega
  | _, _, _, _, _, .seq_cons_l E v vs a as r rs l1 l2 h0 h1 => by
      obtain ⟨L0, n0, c0⟩ := MatchAtPatL.complete h0
      obtain ⟨L1, n1, c1⟩ := MatchAtPatsL.complete h1
      have hlen := MatchAtPatsL.length_eq h1
      refine ⟨L0 ++ L1, max n0 n1 + 1, ?_⟩
      intro oo k m hm hag
      obtain ⟨mm, rfl⟩ : ∃ mm, m = mm + 1 := ⟨m - 1, by omega⟩
      obtain ⟨a0, a1⟩ := agrees2 hag
      simp only [matchAtPats]
      try simp only [hlen, conArgs, and_self, true_and, ite_true, eq_self_iff_true, sconTest_iff, conIs_iff]
      rw [c0 oo (k) mm (by omega) a0]
      try dsimp only
      try simp only [hlen, conArgs, and_self, true_and, ite_true, eq_self_iff_true, sconTest_iff, conIs_iff]
      rw [c1 oo (k + L0.length) mm (by omega) a1]
      try dsimp only
      try simp only [hlen, conArgs, and_self, true_and, ite_true, eq_self_iff_true, sconTest_iff, conIs_iff]
      try simp [hlen, conArgs, and_self, true_and, ite_true, eq_self_iff_true, sconTest_iff, conIs_iff, List.length_append, Nat.add_assoc]
      try omega
end

end StandardElm
